{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/biolababs/edge-litter-detection/schemas/count-ground-truth.schema.json",
  "title": "Edge litter counting ground truth",
  "type": "object",
  "required": [
    "schema_version",
    "frames"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_id": {
      "type": "string"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "frame_index",
          "visible_counts"
        ],
        "properties": {
          "frame_index": {
            "type": "integer",
            "minimum": 1
          },
          "visible_counts": {
            "$ref": "#/$defs/counts"
          }
        },
        "additionalProperties": false
      }
    },
    "unique_session_counts": {
      "$ref": "#/$defs/counts"
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "additionalProperties": false
}
